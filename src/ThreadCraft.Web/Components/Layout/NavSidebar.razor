@namespace ThreadCraft.Web.Components.Layout
@implements IDisposable
@inject ICurriculumService Curriculum
@inject ProgressSummaryService Summary

<aside class="sidebar">
    <div class="sidebar-heading-row">
        <p class="sidebar-heading">Course map</p>
        <button type="button" class="sidebar-toggle-all" @onclick="ToggleAll"
                title="@(_allCollapsed ? "Expand every category" : "Collapse every category")">
            <svg class="sidebar-toggle-all-icon @(_allCollapsed ? "" : "expanded")" aria-hidden="true"
                 width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.6"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>@(_allCollapsed ? "Expand all" : "Collapse all")</span>
        </button>
    </div>
    @foreach (var category in Curriculum.GetCategories())
    {
        var isCollapsed = _collapsedCategoryIds.Contains(category.Id);
        var lessons = Curriculum.GetLessons(category.Id);

        <section class="sidebar-category">
            <button type="button" class="sidebar-category-header" aria-expanded="@(!isCollapsed)"
                    @onclick="() => ToggleCategory(category.Id)">
                <span class="sidebar-chevron @(isCollapsed ? "" : "open")">▸</span>
                <span class="sidebar-category-title">@category.Title</span>
            </button>

            @if (!isCollapsed)
            {
                @if (lessons.Count == 0)
                {
                    <p class="sidebar-empty">Lessons are on their way.</p>
                }
                else
                {
                    <ul class="sidebar-lessons">
                        @foreach (var lesson in lessons)
                        {
                            var passed = Summary.IsPassed(lesson.Id);
                            <li>
                                <NavLink class="sidebar-lesson-link" href="@($"/lesson/{lesson.Id}")">
                                    <span class="sidebar-check @(passed ? "passed" : "")" aria-hidden="true">
                                        @(passed ? "✓" : "")
                                    </span>
                                    <span class="sidebar-lesson-title">@lesson.Title</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                }
            }
        </section>
    }
</aside>

@code {
    private readonly HashSet<string> _collapsedCategoryIds = [];

    // All categories start collapsed — an easier first impression than a wall of 100 lessons.
    private bool _allCollapsed => _collapsedCategoryIds.Count >= Curriculum.GetCategories().Count;

    protected override void OnInitialized()
    {
        Summary.Changed += OnSummaryChanged;
        foreach (var category in Curriculum.GetCategories())
        {
            _collapsedCategoryIds.Add(category.Id);
        }
    }

    private Task OnSummaryChanged() => InvokeAsync(StateHasChanged);

    private void ToggleCategory(string categoryId)
    {
        if (!_collapsedCategoryIds.Remove(categoryId))
        {
            _collapsedCategoryIds.Add(categoryId);
        }
    }

    private void ToggleAll()
    {
        if (_allCollapsed)
        {
            _collapsedCategoryIds.Clear();
        }
        else
        {
            foreach (var category in Curriculum.GetCategories())
            {
                _collapsedCategoryIds.Add(category.Id);
            }
        }
    }

    public void Dispose()
    {
        Summary.Changed -= OnSummaryChanged;
    }
}
