@namespace ThreadCraft.Web.Components.Viz

@* A step-by-step activity diagram for async/await: each code step appears
   as a row when its trace event arrives, with the thread that ran it.
   Fork at await, join at resume. Simple, readable, no timers. *@

@if (Events.Count == 0)
{
    <div class="viz-empty">Run the demo to see the async flow step by step.</div>
}
else
{
    <p class="viz-caption">
        <span class="viz-key viz-key-running"></span> running
        <span class="viz-key viz-key-suspended"></span> awaiting (thread free)
        <span class="viz-key viz-key-continuation"></span> continuation resumed
        <span class="viz-key viz-key-blocked"></span> blocked
    </p>

    <div class="activity-diagram">
        @{ var line = 1; var suspendLane = -1; }
        @for (var i = 0; i < Events.Count; i++)
        {
            var evt = Events[i];
            var isLast = i == Events.Count - 1;

            @if (evt.Kind == "work-start")
            {
                <div class="ad-step" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-code">
                        <span class="ad-line-num">@(line++)</span>
                        <code class="ad-code-text">@evt.Label</code>
                    </div>
                    <div class="ad-thread">
                        <span class="ad-thread-badge running">@evt.ThreadName</span>
                    </div>
                    <div class="ad-note">on this thread</div>
                </div>
            }
            else if (evt.Kind == "work-end")
            {
                <div class="ad-step" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-code">
                        <span class="ad-line-num">@(line++)</span>
                        <code class="ad-code-text">@evt.Label</code>
                    </div>
                    <div class="ad-thread">
                        <span class="ad-thread-badge running">@evt.ThreadName</span>
                    </div>
                    <div class="ad-note">step complete</div>
                </div>
            }
            else if (evt.Kind == "async-suspend")
            {
                suspendLane = evt.ThreadId;
                <div class="ad-step ad-step-suspended" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-code">
                        <span class="ad-line-num">@(line++)</span>
                        <code class="ad-code-text">await ...</code>
                    </div>
                    <div class="ad-thread">
                        <span class="ad-thread-badge suspended">@evt.ThreadName</span>
                    </div>
                    <div class="ad-note">@evt.Label</div>
                </div>
                <div class="ad-fork">
                    <span class="ad-fork-label">method pauses</span>
                    <svg width="40" height="20"><line x1="20" y1="0" x2="20" y2="20" class="ad-fork-line" /></svg>
                    <span class="ad-fork-label">thread RELEASED</span>
                </div>
            }
            else if (evt.Kind == "async-resume")
            {
                var switched = suspendLane >= 0 && suspendLane != evt.ThreadId;
                <div class="ad-join">
                    <svg width="80" height="16">
                        <line x1="10" y1="8" x2="65" y2="8" class="ad-join-line" />
                        <polygon points="60,2 72,8 60,14" fill="#34d399" />
                    </svg>
                    <span class="ad-join-label">@evt.ThreadName picks up the continuation</span>
                </div>
                <div class="ad-step @(switched ? "ad-step-switched" : "ad-step-resumed")" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-code">
                        <span class="ad-line-num">@(line++)</span>
                        <code class="ad-code-text">(after await)</code>
                    </div>
                    <div class="ad-thread">
                        <span class="ad-thread-badge @(switched ? "switched" : "resumed")">@evt.ThreadName</span>
                    </div>
                    <div class="ad-note">@(switched ? "DIFFERENT thread" : "same thread")</div>
                </div>
                suspendLane = -1;
            }
            else if (evt.Kind == "result-blocking")
            {
                <div class="ad-step ad-step-blocked" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-code">
                        <span class="ad-line-num">@(line++)</span>
                        <code class="ad-code-text">.Result / .Wait()</code>
                    </div>
                    <div class="ad-thread">
                        <span class="ad-thread-badge blocked">@evt.ThreadName</span>
                    </div>
                    <div class="ad-note">thread STUCK</div>
                </div>
            }
            else if (evt.Kind == "result-unblocked")
            {
                <div class="ad-step" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-code">
                        <span class="ad-line-num">@(line++)</span>
                        <code class="ad-code-text">@evt.Label</code>
                    </div>
                    <div class="ad-thread">
                        <span class="ad-thread-badge running">@evt.ThreadName</span>
                    </div>
                    <div class="ad-note">thread free again</div>
                </div>
            }
            else if (evt.Kind == "message")
            {
                <div class="ad-step ad-step-note" style="animation-delay:@(i * 0.15)s">
                    <div class="ad-note-full">@evt.Label</div>
                </div>
            }
        }
    </div>
}
@code {
    /// <summary>Trace events collected so far (grows live while a demo runs).</summary>
    [Parameter] public IReadOnlyList<TraceEvent> Events { get; set; } = [];
}