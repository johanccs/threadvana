@namespace ThreadCraft.Web.Components.Shared
@inject IJSRuntime JS

<article class="panel fontsize-settings-card">
    <div class="fontsize-settings-card-header">
        <h3>@Label</h3>
        <div class="fontsize-control" role="group" aria-label="@($"{Label} text size")">
            <button type="button" class="fontsize-btn" @onclick="Decrease" disabled="@(_size <= Min)" title="Decrease text size" aria-label="Decrease text size">A−</button>
            <span class="fontsize-value">@_size px</span>
            <button type="button" class="fontsize-btn" @onclick="Increase" disabled="@(_size >= Max)" title="Increase text size" aria-label="Increase text size">A+</button>
            <button type="button" class="fontsize-btn fontsize-reset-btn" @onclick="Reset" disabled="@(_size == DefaultSize)" title="Reset to default size" aria-label="Reset to default size">↺</button>
        </div>
    </div>
    <p class="fontsize-settings-preview fontsize-zoom-wrap" style="--panel-zoom: @(_size / (double)DefaultSize)">@PreviewText</p>
</article>

@code {
    /// <summary>Unique localStorage key — matches the same panel's inline A-/A+ control exactly.</summary>
    [Parameter, EditorRequired] public string StorageKey { get; set; } = "";

    [Parameter] public string Label { get; set; } = "Panel";
    [Parameter] public string PreviewText { get; set; } = "";
    [Parameter] public int DefaultSize { get; set; } = 16;
    [Parameter] public int Min { get; set; } = 10;
    [Parameter] public int Max { get; set; } = 28;
    [Parameter] public int Step { get; set; } = 1;

    private int _size;

    protected override void OnInitialized()
    {
        _size = DefaultSize;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Read directly and re-render this card itself — no dependency on a parent
        // re-rendering in response to a callback fired outside a UI event (which Blazor
        // does not do automatically), so the preview always reflects the real size.
        _size = await JS.InvokeAsync<int>("ThreadCraft.fontSize.get", StorageKey, DefaultSize);
        StateHasChanged();
    }

    private Task Increase() => SetSizeAsync(Math.Min(Max, _size + Step));

    private Task Decrease() => SetSizeAsync(Math.Max(Min, _size - Step));

    private Task Reset() => SetSizeAsync(DefaultSize);

    private async Task SetSizeAsync(int size)
    {
        if (size == _size)
        {
            return;
        }
        _size = size;
        await JS.InvokeVoidAsync("ThreadCraft.fontSize.set", StorageKey, size);
    }
}
